{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    }
  },
  "globs": [
    "CLAUDE.md",
    "README.md",
    "docs/**/*.md"
  ],
  // The ADR template's <placeholders> are inline HTML to markdownlint.
  "ignores": [
    "docs/adr/0000-template.md"
  ]
}
