#!/bin/sh
# COR-57: marshal git's stdin; policy decisions live in check-push-policy.sh.
set -eu

repo_root="$(git rev-parse --show-toplevel)"
policy="$repo_root/Scripts/check-push-policy.sh"
test -x "$policy"

hook_exit=0
while read -r local_ref local_sha remote_ref remote_sha; do
    # Deleting a remote ref carries no commits and needs no gate receipt.
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    case "$remote_sha" in
        0000000000000000000000000000000000000000)
            # A first push of a topic branch has no remote tip. Check the branch against its
            # merge-base with origin/main, falling back to its first parent in a fresh clone.
            if origin_main="$(git show-ref --verify --hash refs/remotes/origin/main 2>/dev/null)"; then
                remote_sha="$(git merge-base "$local_sha" "$origin_main")"
            else
                remote_sha="$(git rev-parse "$local_sha^" 2>/dev/null)" || {
                    echo "pre-push: REFUSED — cannot establish a base for a first push" >&2
                    hook_exit=1
                    continue
                }
            fi
            ;;
    esac
    "$policy" --remote-ref "$remote_ref" --range "$remote_sha..$local_sha" || hook_exit=1
done
exit "$hook_exit"
