{
  "requirement": "REQ-136",
  "mutations": [
    {
      "rationale": "Allowing an active increment to deliver an already-Done requirement breaks the derived status contract.",
      "kind": "repositoryPolicy",
      "file": "Scripts/check-delivery-status.sh",
      "find": "elif requirement_status[requirement] == \"Done\":",
      "replace": "elif False and requirement_status[requirement] == \"Done\":",
      "expect_red": ["Scripts/test-check-delivery-status.sh"]
    }
  ]
}
