# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Xcode — user-specific & build artifacts
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
build/
DerivedData/
*.moved-aside

# Process-level smoke/screenshot verification artifacts (Scripts/smoke-test.sh,
# Scripts/smoke-screenshot.sh) — local build output and a one-shot visual-review PNG, never
# committed.
.smoke-build/
.smoke-screenshot.png

# Coverage profiles from instrumented local test runs. Scripts/smoke-*.sh already redirect
# LLVM_PROFILE_FILE into their own temp dirs; this covers an ordinary `xcodebuild test`.
*.profraw

# Scripts/fast-check.sh local build output
.fast-check-build/
.fast-check-build.log

# Push-policy gate receipt and full-check artifacts
.gate-receipt.json
.gate-receipt.json.tmp.*
.full-check-build/
.full-check-build.log

# Scripts/benchmark.sh Release build output. Every sibling build directory was already listed;
# this one was missing because the script had never been run to completion.
.benchmark-build/

# Swift Package Manager
.build/
.swiftpm/
# Keep Package.resolved committed so the pinned cmark revision is reproducible.
# Package.resolved

# Obj-C / legacy user files
*.pbxuser
!default.pbxuser
*.perspectivev3
!default.perspectivev3

# Dependency managers (unused, listed defensively)
Pods/
Carthage/Build/
.perf-suite-build/
.perf-suite.log
